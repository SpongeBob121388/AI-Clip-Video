# 应用配置
ACV_ENVIRONMENT=development
ACV_HOST=127.0.0.1
ACV_PORT=8765

# 日志
ACV_LOG_LEVEL=INFO
ACV_LOG_FORMAT=json

# 数据目录
ACV_DATA_DIR=./data
ACV_PROJECTS_DIR=./data/projects
ACV_GLOBAL_DB_PATH=./data/app.db

# FFmpeg
ACV_FFMPEG_PATH=ffmpeg
ACV_FFPROBE_PATH=ffprobe

# 渲染限制
ACV_MAX_RENDER_DURATION_MINUTES=15
ACV_RENDER_TIMEOUT_SECONDS=900